# Architecture A (web/) configuration
STUB_LLM=false

# ---- Architecture A LLM provider (dual-provider support) ----
# Provider: groq (default) or openrouter. Keys are NEVER printed or committed.
# ARCH_A_LLM_PROVIDER=groq
# ARCH_A_LLM_API_KEY=your_arch_a_api_key_here
# ARCH_A_LLM_MODEL=openai/gpt-oss-120b
# ARCH_A_LLM_BASE_URL=           (optional override)
# Example - OpenRouter:
# ARCH_A_LLM_PROVIDER=openrouter
# ARCH_A_LLM_MODEL=some-org/some-model:free
# ARCH_A_LLM_API_KEY=your_openrouter_key_here

# Legacy Groq-only variables (still honoured when ARCH_A_* are absent):
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_A=openai/gpt-oss-120b
GROQ_MAX_TOKENS_A=1500

# Exploration limits (optional)
MAX_STEPS=25
MAX_STATES=15
MAX_DEPTH=8
MAX_ACTIONS_PER_STATE=4
HEADLESS=true
